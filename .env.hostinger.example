# =============================================================================
# ReelFlow — Hostinger shared hosting (Business plan) configuration
# deploy/hostinger/deploy.sh copies this to <APP_DIR>/shared/.env on the first
# deploy. Fill in the DB_* values (hPanel → Databases) and re-run the deploy.
# Shared hosting has no FFmpeg, Redis or background daemons, so:
#   MEDIA_PROCESSING=agent  — the sync agent runs FFmpeg on your computer
#   REELFLOW_QUEUE_MODE=cron — workers are started by the every-minute cron
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=ReelFlow
APP_ENV=production
APP_KEY=                         # php artisan key:generate
APP_DEBUG=false
APP_URL=https://reels.smartsoch.store
APP_TIMEZONE=UTC                 # keep UTC; display timezone is REELFLOW_TIMEZONE
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
TRUSTED_PROXIES=*                # Hostinger CDN (hcdn) sits in front of the site

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- ReelFlow ----------------------------------------------------------------
REELFLOW_TIMEZONE=Asia/Kolkata   # display + default posting-rule timezone
REELFLOW_ADMIN_EMAIL=you@example.com   # default notification recipient, Horizon alerts
REELFLOW_OPERATOR_NAME="Your Name"     # shown on the public /privacy and /terms pages

# Defaults for newly invited users (0 = unlimited); editable per user in Admin → Users
WORKSPACE_STORAGE_MB=2048
WORKSPACE_MAX_ACCOUNTS=5
WORKSPACE_DAILY_AI_LIMIT=50      # free AI quotas are shared by all users

# --- Database (MySQL 8 / MariaDB 10.4+) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_reelflow    # hPanel → Databases → MySQL Databases
DB_USERNAME=u000000000_reelflow
DB_PASSWORD=change-me
DB_TIMEZONE=+00:00               # session timezone; leave as UTC

# --- Sessions / cache / queue (Redis) ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database             # no Redis on shared hosting
QUEUE_CONNECTION=database
QUEUE_LONG_CONNECTION=database-long
DB_QUEUE_RETRY_AFTER=960
DB_LONG_QUEUE_RETRY_AFTER=3900
REELFLOW_QUEUE_MODE=cron

REDIS_CLIENT=predis              # unused in cron mode

BROADCAST_CONNECTION=log

# --- Video storage (private) --------------------------------------------------
# "videos"    = private directory on this server's disk (FREE, default)
# "videos_s3" = private S3-compatible bucket. Only free inside a provider's
#               free tier (e.g. Backblaze B2 / Cloudflare R2 ~10 GB) — paid beyond it.
VIDEO_STORAGE_DISK=videos
THUMBNAIL_STORAGE_DISK=videos
VIDEO_LOCAL_ROOT=                # optional absolute path for the "videos" disk
SIGNED_URL_TTL_MINUTES=120
VIDEO_CLEANUP_AFTER_DAYS=14      # free disk space: delete originals 14 days after all their posts are published (empty = keep)

# Only needed for VIDEO_STORAGE_DISK=videos_s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com, https://s3.wasabisys.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_VIDEO_PREFIX=videos

FILESYSTEM_DISK=local

# --- Sync agent uploads -------------------------------------------------------
UPLOAD_ALLOWED_EXTENSIONS=mp4,mov,webm,m4v
UPLOAD_MAX_FILE_SIZE_MB=1024
UPLOAD_CHUNK_SIZE_MB=4           # small chunks stay inside shared-hosting request limits
UPLOAD_SESSION_TTL_HOURS=48
UPLOAD_FAILURE_ALERT_THRESHOLD=3
SYNC_DEVICE_OFFLINE_MINUTES=30

# --- Browser uploads (Upload videos page) -------------------------------------
WEB_UPLOAD_MAX_MB=200            # per upload (one ZIP or the selected videos)
WEB_UPLOAD_MAX_VIDEOS=20         # videos per ZIP
WEB_UPLOAD_CHUNK_MB=4            # stays under shared-hosting request limits

# --- Google Drive import (Setup → Google Drive import) -----------------------
# Admin → Credentials can set these in the app; values saved there win over .env.
GOOGLE_DRIVE_API_KEY=            # optional; empty = public "Anyone with the link" folder page
DRIVE_IMPORT_BATCH=40            # files downloaded per 5-minute run

# --- FFmpeg -------------------------------------------------------------------
# Hostinger has no FFmpeg, so by default the sync agent does this locally.
# deploy/hostinger/install-ffmpeg.sh installs a free static FFmpeg in your home
# folder; then set MEDIA_PROCESSING=server and the two paths it prints. That is
# required for the Google Drive import (no computer needed).
MEDIA_PROCESSING=agent
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_THREADS=1                 # shared hosting limits threads per account
FFMPEG_TIMEOUT=300
VIDEO_MIN_DURATION=3
VIDEO_MAX_DURATION=900

# --- AI captions ---------------------------------------------------------------
# Admin → Credentials can set these in the app; values saved there win over .env.
# FREE:  gemini  — Google AI Studio free tier (key from https://aistudio.google.com/apikey)
#        groq    — Groq free tier (key from https://console.groq.com; set AI_MODEL to a vision model)
#        ollama  — self-hosted on this server, no key (https://ollama.com)
#        compatible — any other OpenAI-compatible endpoint (set AI_BASE_URL + AI_MODEL)
#        none    — no AI; write captions in the Content Studio
# PAID:  openai | anthropic
AI_PROVIDER=gemini
AI_MODEL=                        # empty = preset default (gemini: gemini-flash-latest, ollama: qwen3-vl:8b)
AI_API_KEY=                      # not needed for ollama
AI_BASE_URL=                     # empty = preset default
AI_JSON_MODE=                    # empty = preset default; json_schema | json_object | none
AI_TIMEOUT=300                   # free tiers can be slow; use 600+ for ollama on a CPU-only server
AI_REASONING_EFFORT=none         # gemini: "none" answers much faster; empty = provider default
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_FRAMES=6                  # use 3 for ollama on a CPU-only server
AI_FRAME_WIDTH=512
AI_MAX_VIDEO_SIZE_MB=1024
AI_DAILY_BUDGET_USD=             # only meaningful for paid providers
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=
AI_LOW_CONFIDENCE_THRESHOLD=0.6
AI_PROMPT_VERSION=v1             # resources/prompts/caption_system_{version}.txt

# Optional audio transcription: none | groq (free tier Whisper) | compatible (self-hosted Whisper server) | openai (paid)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_MODEL=             # empty = groq: whisper-large-v3
TRANSCRIPTION_API_KEY=           # empty = AI_API_KEY
TRANSCRIPTION_BASE_URL=          # empty = provider default
TRANSCRIPTION_MAX_SECONDS=600

# --- Meta (Facebook Pages + Instagram professional accounts) ------------------
# Admin → Credentials can set these in the app; values saved there win over .env.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/oauth/meta/callback"
META_CONFIG_ID=                  # only for "Facebook Login for Business" apps (Configuration ID)
META_GRAPH_VERSION=v23.0
INSTAGRAM_UPLOAD_MODE=resumable  # resumable (no public URL needed) | video_url (signed URL must be reachable by Meta)
INSTAGRAM_MAX_HASHTAGS=5

# --- Google / YouTube ----------------------------------------------------------
# Admin → Credentials can set these in the app; values saved there win over .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
YOUTUBE_ENABLED=false            # true once the Google project has enough upload quota
YOUTUBE_CATEGORY_ID=22           # 22 = People & Blogs
YOUTUBE_SHORTS_MAX_SECONDS=180
YOUTUBE_REQUIRE_SHORTS_FORMAT=true

# --- Publishing defaults --------------------------------------------------------
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_BASE_SECONDS=60
PUBLISH_RETRY_MAX_SECONDS=3600
PUBLISH_PROCESSING_POLL_SECONDS=60
PUBLISH_PROCESSING_TIMEOUT_MINUTES=60
PUBLISH_CLAIM_TIMEOUT_MINUTES=70  # must exceed the 60-minute publish job timeout
PUBLISH_DISPATCH_BATCH=25
PUBLISH_UPLOAD_CHUNK_MB=8
PUBLISH_HTTP_TIMEOUT=600

SCHEDULE_PLANNING_DAYS=2
SCHEDULE_DEFAULT_SLOTS=08:30,11:00,13:30,16:30,20:00
SCHEDULE_DEFAULT_DAILY_LIMIT=5
SCHEDULE_DEFAULT_MIN_INTERVAL=90

# --- Mail (SMTP) ----------------------------------------------------------------
# Admin → Credentials can set these in the app; values saved there win over .env.
# Included with Hostinger Business: create a mailbox in hPanel → Emails
# (e.g. reelflow@yourdomain.com) and use it here.
MAIL_MAILER=log                  # switch to smtp once MAIL_PASSWORD is set
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=reelflow@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reelflow@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
